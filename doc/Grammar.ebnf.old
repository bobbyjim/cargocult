XENOBER16 EBNF GRAMMAR
=======================

This EBNF uses:
- { ... } for zero-or-more repetition
- [ ... ] for optional elements
- | for alternation
- Quoted strings for literals
- Semicolons mark statement/declaration endings

---

Xenober16 ::=
    ProgramIdentificationDivision
    [ImportDivision]
    [ConstantsDivision]
    [MemoryDivision]
    [MacroDivision]
    [DataDivision]
    [EnumDivision]
    [ProcedureDivision]
    [MainDivision]
    "MODULE END."
;

/* IDENTIFICATION DIVISION */

ProgramIdentificationDivision ::=
    "MODULE IDENTIFICATION DIVISION."
    ModuleID
    [ModuleParameters]
    [Author]
    [Description]
    [Purpose]
;

ModuleID ::=
    ( "MODULE-ID." | "ID:" ) Identifier "."
;

ModuleParameters ::=
    ( "PARAMETERS" | "PARAMS:" ) ":" ParameterDeclList ";"
;

ParameterDeclList ::=
    ParameterDecl { "," ParameterDecl }
;

ParameterDecl ::=
    Identifier ":" Type [ParameterInit]
;

ParameterInit ::=
    ":=" Expression
;

Author ::=
    ( "AUTHOR." | "WHO:" | "BY:" ) Identifier "."
;

Description ::=
    ( "DESCRIPTION." | "WHAT:" | "DESC:" ) RestOfLine
;

Purpose ::=
    ( "PURPOSE." | "WHY:" ) RestOfLine
;

RestOfLine ::=
    { <any-character-except-newline> }
;

/* IMPORT DIVISION */

ImportDivision ::=
    "IMPORT DIVISION." Use { Use }
;

Use ::=
    "-" Identifier ";"
;

/* CONSTANTS DIVISION */

ConstantsDivision ::=
    "CONSTANTS DIVISION." ConstantDeclaration { ConstantDeclaration }
;

ConstantDeclaration ::=
    Identifier
    (
        ":" Type "=" ConstantValue
      | ":=" ConstantValue
    )
    ";"
;

ConstantValue ::=
    Number | String
;

/* MACRO DIVISION */

MacroDivision ::=
    "MACRO DIVISION." MacroDeclaration { MacroDeclaration }
;

MacroDeclaration ::=
    FunctionLikeMacro | SimpleMacro
;

FunctionLikeMacro ::=
    "META" Identifier "(" [ParameterList] ")" ":" Type
    "BEGIN"
        Statement { Statement }
    "END" Identifier ";"
;

SimpleMacro ::=
    Identifier ":" MacroType "IS" Expression ";"
;

MacroType ::=
    "int8" | "int16" | "byte" | "uint8" | "uint16" | "char" | "string"
;

ParameterList ::=
    Parameter { "," Parameter }
;

Parameter ::=
    Identifier ":" Type
;

/* MEMORY DIVISION */

MemoryDivision ::=
    "MEMORY DIVISION." Area { Area }
;

Area ::=
    "AREA" Identifier ( RamArea | BankArea ) "SIZE" Number ";"
;

RamArea ::=
    "RAM" "(" Number ")"
;

BankArea ::=
    "BANK" "(" Number "," Number ")"
;

/* DATA DIVISION */

DataDivision ::=
    "DATA DIVISION." VariableDeclaration { VariableDeclaration }
;

VariableDeclaration ::=
    "VAR" Identifier ":" Type [AreaAnnotation] [VariableInit] ";"
;

VariableInit ::=
    ":=" NestedInit
;

AreaAnnotation ::=
    "AT" Identifier
;

Type ::=
    ArrayType | BuiltinType | PointerType | NamedType
;

BuiltinType ::=
    "uint16" | "uint8" | "int16" | "int8" | "string" | "char" | "byte"
;

ArrayType ::=
    "array" "[" Number "]" "of" Type [ArrayInit]
;

ArrayInit ::=
    ":=" "{" NestedInitList "}"
;

NestedInitList ::=
    NestedInit { "," NestedInit }
;

PointerType ::=
    "@" Identifier
;

NamedType ::=
    Identifier
;

RecordType ::=
    "RECORD" { RecordField } "END"
;

RecordField ::=
    Identifier ":" Type [BitfieldAnnotation] ";"
;

BitfieldAnnotation ::=
    "@BITFIELD" "(" Number ")"
;

/* ENUM DIVISION */

EnumDivision ::=
    "ENUM DIVISION." EnumDeclaration { EnumDeclaration }
;

EnumDeclaration ::=
    "ENUM" [Identifier] "{" EnumMember { "," EnumMember } "}" ";"
;

EnumMember ::=
    Identifier [ "=" Number | ":=" Number ]
;

/* PROCEDURE DIVISION */

ProcedureDivision ::=
    "PROCEDURE DIVISION." Procedure { Procedure }
;

Procedure ::=
    "FN" Identifier "(" [ParameterList] ")"
        Statement { Statement }
    "END"
;

/* MAIN DIVISION */

MainDivision ::=
    "MAIN DIVISION." Statement { Statement }
;

/* STATEMENTS */

Statement ::=
    KeywordStatement | SimpleStatement
;

KeywordStatement ::=
    IfStatement | WhileLoop | ForLoop | RepeatLoop | CaseStatement
;

SimpleStatement ::=
    Say | Echo | Assignment | ProcedureCall | Return
;

IfStatement ::=
    "IF" Expression "THEN"
        { Statement }
    { "ELSIF" Expression "THEN" { Statement } }
    [ "ELSE" { Statement } ]
    "END"
;

WhileLoop ::=
    "WHILE" Expression "DO"
        Statement { Statement }
    "END"
;

RepeatLoop ::=
    "REPEAT"
        Statement { Statement }
    "UNTIL" Expression ";"
;

ForLoop ::=
    "FOR" Identifier ":=" Expression "TO" Expression "DO"
        Statement { Statement }
    [ "END" ]
;

CaseStatement ::=
    "CASE" Expression "OF"
        CaseWhen { CaseWhen }
    [ "ELSE" Statement { Statement } ]
    "END"
;

CaseWhen ::=
    "|" CaseSelector { "," CaseSelector } ":" Statement { Statement }
;

CaseSelector ::=
    Range | Number | Designator
;

Say ::=
    "SAY" Expression ";"
;

Echo ::=
    "ECHO" Expression ";"
;

Assignment ::=
    Designator ":=" Expression ";"
;

ProcedureCall ::=
    Identifier "(" [ArgumentList] ")" ";"
;

Return ::=
    "RETURN" Expression ";"
;

ArgumentList ::=
    Expression { "," Expression }
;

/* EXPRESSIONS */

Expression ::=
    Comparison
;

Comparison ::=
    MathSum { CompareOperator MathSum }
;

CompareOperator ::=
    "==" | "!=" | ">=" | "<=" | ">" | "<"
;

MathSum ::=
    MathProduct { AddOperator MathProduct }
;

AddOperator ::=
    "+" | "-"
;

MathProduct ::=
    Factor { MulOperator Factor }
;

MulOperator ::=
    "*" | "/"
;

Factor ::=
    "(" Expression ")"
  | RamAccess
  | BankAccess
  | Number
  | String
  | Designator
  | "~" Factor
;

RamAccess ::=
    "RAM" "[" Expression "]"
;

BankAccess ::=
    "BANK" "(" Expression ")" "[" Expression "]"
;

Designator ::=
    QualIdent { Selector }
;

QualIdent ::=
    [ Identifier "." ] Identifier
;

Selector ::=
    "[" Expression "]"           /* Array/map indexing */
  | "." Identifier               /* Field access */
  | "(" [ArgumentList] ")"       /* Function call */
;

Range ::=
    Number ".." Number
;

NestedInit ::=
    Number | String | RecordInit | EnumInit | ArrayInit
;

RecordInit ::=
    "{" NestedInitList "}"
;

EnumInit ::=
    "{" NestedInitList "}"
;

/* TERMINALS */

Number ::=
    DecNumber | HexNumber
;

DecNumber ::=
    Digit { Digit }
;

HexNumber ::=
    "$" HexDigit { HexDigit }
;

String ::=
    '"' { <any-char-except-quote> | '\\' <any-char> } '"'
;

Identifier ::=
    Letter { Letter | Digit | "_" | "-" }
;

Letter ::=
    "a".."z" | "A".."Z" | "_"
;

Digit ::=
    "0".."9"
;

HexDigit ::=
    Digit | "a".."f" | "A".."F"
;

/* WHITESPACE AND COMMENTS */

Whitespace ::=
    <space> | <tab> | <newline>
;

Comment ::=
    "//" { <any-char-except-newline> }
;

/* Whitespace and comments are ignored between tokens */

