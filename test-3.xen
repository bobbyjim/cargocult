IDENTIFICATION DIVISION.
PROGRAM-ID. HelloWorld.

DATA DIVISION.

WORKING-STORAGE SECTION.
  message: UINT8;
  anotherMessage: STRING;

PROCEDURE DIVISION.
   message := $65;
   anotherMessage := "hello, world!";

   message := message + 5;
   SAY message;

   IF message > 60
   THEN
       SAY "greater than 60";
   ELSIF message > 50
   THEN
       SAY "greater than 50";
   ELSE
       SAY "less than 51";
   END

END PROGRAM.
