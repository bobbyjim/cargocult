MODULE IDENTIFICATION DIVISION.
    MODULE-ID. ProcedureTest.
    AUTHOR. Rob.
    DESCRIPTION. Tests procedure definitions and calls with parameters.

DATA DIVISION.
    VAR result: uint8;
    VAR x: uint8;
    VAR y: uint8;

PROCEDURE DIVISION.
    FN greet(name: uint8)
        SAY "Hello";
        SAY name;
    END

    FN greet2(name: uint8)
        SAY "Hello2";
        SAY name;
    END

    FN greet3(name: uint8)
        SAY "Hello3";
        SAY name;
    END

    FN greet4(name: uint8)
        SAY "Hello4";
        SAY name;
    END

    FN greet5(name: uint8)
        SAY "Hello5";
        SAY name;
    END

    FN add(a: uint8, b: uint8)
        result := a + b;
        SAY result;
    END
    
    FN multiply(a: uint8, b: uint8)
        result := a * b;
        SAY result;
    END


MAIN DIVISION.
    x := 10;
    y := 5;
    
    greet(42);
    
    SAY "Addition test";
    add(x, y);
    
    SAY "Multiplication test";
    multiply(x, y);
    
    add(100, 50);

MODULE END.
