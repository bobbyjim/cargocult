MODULE IDENTIFICATION DIVISION.
    MODULE-ID. ExpressionTest.
    AUTHOR. Rob.
    DESCRIPTION. Tests arithmetic expressions and operator precedence.

DATA DIVISION.
    VAR result: uint8;
    VAR value: uint8;

ENUM DIVISION.
    ENUM SpriteMode {
        DISABLED = 0,
        NORMAL = 1,
        MULTICOLOR = 2,
        HIRES = 3
    };

MAIN DIVISION.
    value := 10;
    
    result := value * 2 + 5;
    SAY result;
    
    result := (value + 5) * 2;
    SAY result;
    
    result := value * 2 + 1 * 10;
    SAY result;
    
    result := value - 3 + 2;
    SAY result;

MODULE END.
