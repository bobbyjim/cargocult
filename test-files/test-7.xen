MODULE IDENTIFICATION DIVISION.
    MODULE-ID. ConstantsTest.
    AUTHOR. Rob.
    DESCRIPTION. Tests CONSTANTS DIVISION and constant usage.

CONSTANTS DIVISION.
    max-value: uint8 = 100;
    min-value: uint8 = 10;
    pi: uint8 = 3;
    greeting: string = "Hello from constants!";

DATA DIVISION.
    value: uint8;
    result: uint8;

MAIN DIVISION.
    SAY greeting;
    
    value := max-value;
    SAY value;
    
    result := max-value - min-value;
    SAY result;
    
    IF value >= max-value THEN
        SAY "At maximum";
    ELSIF value <= min-value THEN
        SAY "At minimum";
    ELSE
        SAY "In range";
    END

MODULE END.
