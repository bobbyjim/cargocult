IDENTIFICATION DIVISION.
PROGRAM-ID. HelloWorld.

DATA DIVISION.

WORKING-STORAGE SECTION.
  message: UINT8;

PROCEDURE DIVISION.
   message := $65;

   SAY "Counting down to 20";
   WHILE message > 20 DO
      message := message - 5;
      SAY message;
   END

   SAY "Counting up to 30";
   REPEAT
      message := message + 1;
      SAY message;
   UNTIL message > 30;
   END

   IF message > 60
   THEN
       SAY "greater than 60";
   ELSIF message > 50
   THEN
       SAY "greater than 50";
   ELSE
       SAY "less than 51";
   END

END PROGRAM.
